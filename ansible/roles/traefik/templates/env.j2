#jinja2: trim_blocks: True, lstrip_blocks: True
# Managed by Ansible — do not edit by hand.
# Rendered from ansible/roles/traefik/templates/env.j2 for env "{{ env_name }}".

# --- Image ------------------------------------------------------------------
COMPOSE_PROJECT_NAME={{ traefik_compose_project }}
TRAEFIK_TAG={{ traefik_image_tag }}
LOG_LEVEL={{ traefik_log_level }}

# --- Listening address ------------------------------------------------------
BIND_ADDRESS={{ traefik_bind_address }}
HTTP_PORT={{ traefik_http_port }}
HTTPS_PORT={{ traefik_https_port }}
METRICS_PORT={{ traefik_metrics_port }}

# --- ACME -------------------------------------------------------------------
ACME_EMAIL={{ acme_email }}
ACME_CA_SERVER={{ acme_ca_servers[acme_ca_server] }}
ACME_DNS_PROVIDER={{ acme_dns_provider }}
ACME_DNS_RESOLVERS={{ acme_dns_resolvers }}
ACME_DELAY_BEFORE_CHECKS={{ acme_delay_before_checks }}

# --- DNS provider credentials -----------------------------------------------
{% for key, value in acme_dns_credentials | dictsort %}
{{ key }}={{ value }}
{% endfor %}
