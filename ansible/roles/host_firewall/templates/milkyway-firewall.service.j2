[Unit]
Description=MilkyWay guest ingress policy
Before=docker.service tailscaled.service
After=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/nftables.d/milkyway.nft
ExecReload=/usr/sbin/nft -f /etc/nftables.d/milkyway.nft

[Install]
WantedBy=multi-user.target
