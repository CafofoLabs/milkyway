[Unit]
Description=MilkyWay native Proxmox DNS-01 certificate reconciliation
Wants=network-online.target
After=network-online.target tailscaled.service

[Service]
Type=oneshot
User=root
UMask=0077
LoadCredential=hostinger_api_token:{{ proxmox_tls_config_dir }}/hostinger_api_token
Environment=HOSTINGER_API_TOKEN_FILE=%d/hostinger_api_token
Environment=HOSTINGER_PROPAGATION_TIMEOUT={{ proxmox_tls_propagation_timeout | int }}
UnsetEnvironment=HOSTINGER_API_TOKEN LEGO_DEBUG_ACME_HTTP_CLIENT LEGO_DEBUG_DNS_API_HTTP_CLIENT
ExecStart={{ proxmox_tls_script }}
TimeoutStartSec=3600
StandardOutput=journal
StandardError=journal
