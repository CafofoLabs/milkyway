#jinja2: trim_blocks: True, lstrip_blocks: True
# Managed by Ansible — do not edit by hand.
# Rendered from ansible/roles/authentik/templates/env.j2 for env "{{ env_name }}".

# --- Images -----------------------------------------------------------------
COMPOSE_PROJECT_NAME={{ authentik_compose_project }}
AUTHENTIK_IMAGE={{ authentik_image }}
AUTHENTIK_TAG={{ authentik_tag }}
PG_TAG={{ authentik_pg_tag }}

# --- Database ---------------------------------------------------------------
PG_DB=authentik
PG_USER=authentik
PG_PASS={{ authentik_pg_password }}
PG_MAX_CONNECTIONS={{ authentik_pg_max_connections }}

# --- Core -------------------------------------------------------------------
AUTHENTIK_SECRET_KEY={{ authentik_secret_key }}
AUTHENTIK_HOST={{ authentik_host_url }}
AUTHENTIK_LOG_LEVEL={{ authentik_log_level }}
AUTHENTIK_ERROR_REPORTING__ENABLED={{ authentik_error_reporting | lower }}
AUTHENTIK_DISABLE_UPDATE_CHECK={{ authentik_disable_update_check | lower }}
AUTHENTIK_DISABLE_STARTUP_ANALYTICS=true

# --- Networking -------------------------------------------------------------
BIND_ADDRESS={{ authentik_bind_address }}
COMPOSE_PORT_HTTP={{ authentik_port_http }}
COMPOSE_PORT_HTTPS={{ authentik_port_https }}
COMPOSE_PORT_METRICS={{ authentik_port_metrics }}
{% if authentik_trusted_proxy_cidrs %}
AUTHENTIK_LISTEN__TRUSTED_PROXY_CIDRS={{ authentik_trusted_proxy_cidrs }}
{% endif %}
{% if authentik_cookie_domain %}
AUTHENTIK_COOKIE_DOMAIN={{ authentik_cookie_domain }}
{% endif %}

# --- Bootstrap (consumed only while the database is empty) ------------------
AUTHENTIK_BOOTSTRAP_PASSWORD={{ authentik_bootstrap_password }}
AUTHENTIK_BOOTSTRAP_TOKEN={{ authentik_bootstrap_token }}
AUTHENTIK_BOOTSTRAP_EMAIL={{ authentik_bootstrap_email }}

{% if authentik_email %}
# --- Email ------------------------------------------------------------------
AUTHENTIK_EMAIL__HOST={{ authentik_email.host }}
AUTHENTIK_EMAIL__PORT={{ authentik_email.port | default(587) }}
AUTHENTIK_EMAIL__USERNAME={{ authentik_email.username | default('') }}
AUTHENTIK_EMAIL__PASSWORD={{ authentik_email.password | default('') }}
AUTHENTIK_EMAIL__USE_TLS={{ authentik_email.use_tls | default(true) | lower }}
AUTHENTIK_EMAIL__USE_SSL={{ authentik_email.use_ssl | default(false) | lower }}
AUTHENTIK_EMAIL__TIMEOUT={{ authentik_email.timeout | default(10) }}
AUTHENTIK_EMAIL__FROM={{ authentik_email.from | default(authentik_bootstrap_email) }}
{% endif %}

# --- Docker integration -----------------------------------------------------
DOCKER_SOCKET=/var/run/docker.sock
