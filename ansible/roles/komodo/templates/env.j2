# GENERATED — do not edit by hand. Managed by Ansible (env.j2).
COMPOSE_PROJECT_NAME={{ komodo_compose_project }}
COMPOSE_KOMODO_IMAGE_TAG={{ komodo_image_tag }}
MONGO_TAG={{ komodo_mongo_tag }}
BIND_ADDRESS=127.0.0.1
KOMODO_PORT={{ komodo_port }}
COMPOSE_KOMODO_BACKUPS_PATH={{ komodo_deploy_dir }}/backups
PERIPHERY_ROOT_DIRECTORY={{ komodo_deploy_dir }}/periphery
TZ=Etc/UTC

## Database
KOMODO_DATABASE_USERNAME=admin
KOMODO_DATABASE_PASSWORD={{ komodo_mongo_password }}

## Core
KOMODO_HOST={{ komodo_host_url }}
KOMODO_TITLE={{ komodo_title }}
KOMODO_PERIPHERY_PUBLIC_KEY=file:/config/keys/periphery.pub
KOMODO_LOCAL_AUTH=true
KOMODO_INIT_ADMIN_USERNAME=admin
KOMODO_INIT_ADMIN_PASSWORD={{ komodo_admin_password }}
KOMODO_FIRST_SERVER_NAME={{ komodo_server_name }}
KOMODO_WEBHOOK_SECRET={{ komodo_webhook_secret }}
KOMODO_JWT_SECRET={{ komodo_jwt_secret }}

## Auto-enable users on first login — single-operator instance behind
## Authentik SSO (access already gated by the platform_admins group), so a
## second manual approval step here would only add friction.
KOMODO_ENABLE_NEW_USERS=true

## OIDC (Authentik) — enabled only when credentials were found in OpenBao.
KOMODO_OIDC_ENABLED=true
KOMODO_OIDC_PROVIDER={{ komodo_oidc_issuer | default('') }}
KOMODO_OIDC_CLIENT_ID={{ komodo_oidc_client_id | default('') }}
KOMODO_OIDC_CLIENT_SECRET={{ komodo_oidc_client_secret | default('') }}

## Periphery
PERIPHERY_CORE_ADDRESS=ws://core:9120
PERIPHERY_CONNECT_AS={{ komodo_server_name }}
PERIPHERY_CORE_PUBLIC_KEYS=file:/config/keys/core.pub
