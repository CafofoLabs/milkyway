#jinja2: trim_blocks: True, lstrip_blocks: True
# Managed by Ansible — do not edit by hand.
# Rendered from ansible/roles/observability/templates/prometheus.yml.j2.
#
# Note what is almost absent here: scrape targets. Every host on the platform
# runs an agent that pushes to this server's remote-write receiver, so the list
# of things being observed lives in the Ansible inventory rather than in this
# file. The only scrape jobs below are this host's own stack, which is on
# loopback and needs no discovery.
#
# See docs/observability.md, "Why the agents push".

global:
  scrape_interval: {{ observability_scrape_interval }}
  evaluation_interval: {{ observability_evaluation_interval }}
  external_labels:
    env: {{ env_name }}

rule_files:
  - /etc/prometheus/rules/*.yml

# Compose service names, not addresses.
#
# Every target below is a sibling container on this stack's default compose
# network, and `127.0.0.1` inside Prometheus's container is Prometheus. The
# published ports are on the host, which Prometheus cannot reach from a bridge
# network — so loopback here silently scrapes nothing but itself, which is
# exactly the shape of failure that looks like it is working.
#
# The container ports are used, not the published ones: those two are
# configurable independently, and inside the network only the container's own
# port exists.
alerting:
  alertmanagers:
    - static_configs:
        - targets: ["alertmanager:9093"]

scrape_configs:
  # The observability stack watching itself. If these are the only jobs
  # returning data, the agents are not reaching the remote-write receiver.
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]
        labels:
          host: {{ inventory_hostname }}

  - job_name: loki
    static_configs:
      - targets: ["loki:3100"]
        labels:
          host: {{ inventory_hostname }}

  - job_name: alertmanager
    static_configs:
      - targets: ["alertmanager:9093"]
        labels:
          host: {{ inventory_hostname }}

  - job_name: grafana
    static_configs:
      - targets: ["grafana:3000"]
        labels:
          host: {{ inventory_hostname }}
