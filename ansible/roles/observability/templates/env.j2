#jinja2: trim_blocks: True, lstrip_blocks: True
# Managed by Ansible — do not edit by hand.
# Rendered from ansible/roles/observability/templates/env.j2.

COMPOSE_PROJECT_NAME={{ observability_compose_project }}

PROMETHEUS_TAG={{ observability_prometheus_tag }}
LOKI_TAG={{ observability_loki_tag }}
ALERTMANAGER_TAG={{ observability_alertmanager_tag }}
GRAFANA_TAG={{ observability_grafana_tag }}

BIND_ADDRESS={{ observability_bind_address }}
PROMETHEUS_PORT={{ observability_prometheus_port }}
LOKI_PORT={{ observability_loki_port }}
ALERTMANAGER_PORT={{ observability_alertmanager_port }}
GRAFANA_PORT={{ observability_grafana_port }}

PROMETHEUS_RETENTION={{ observability_metrics_retention }}
PROMETHEUS_RETENTION_SIZE={{ observability_metrics_retention_size }}
PROMETHEUS_EXTERNAL_URL=http://{{ observability_bind_address }}:{{ observability_prometheus_port }}
ALERTMANAGER_EXTERNAL_URL=http://127.0.0.1:{{ observability_alertmanager_port }}

GRAFANA_ROOT_URL={{ observability_grafana_url }}

# Local fallback administrator. Normal access is OIDC through authentik; this
# is what is left when authentik is the thing that is down.
GF_SECURITY_ADMIN_USER={{ observability_grafana_admin_user }}
GF_SECURITY_ADMIN_PASSWORD={{ observability_grafana_admin_password }}

# Anonymous access off, and sign-up off: authentik decides who exists.
GF_AUTH_ANONYMOUS_ENABLED=false
GF_USERS_ALLOW_SIGN_UP=false

{% if observability_oidc | length > 0 %}
# --- Single sign-on ---------------------------------------------------------
# Every value below comes from the OpenTofu outputs, including the endpoint
# URLs. They could be built from the authentik base URL and the application
# slug — the shape is stable and documented — but constructing them here would
# mean this file quietly encoding authentik's URL layout, and being wrong the
# day it changes or the slug does. The module already publishes them, and
# reading what a thing says about itself beats inferring it.
#
# The same applies to the client secret: rotating it is one `make tofu-apply`
# followed by one `make deploy-observability`, and it is never copied by hand.
GF_AUTH_GENERIC_OAUTH_ENABLED=true
GF_AUTH_GENERIC_OAUTH_NAME=authentik
GF_AUTH_GENERIC_OAUTH_CLIENT_ID={{ observability_oidc.client_id }}
GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET={{ observability_oidc.client_secret }}
GF_AUTH_GENERIC_OAUTH_SCOPES=openid email profile
GF_AUTH_GENERIC_OAUTH_AUTH_URL={{ observability_oidc.authorization_url }}
GF_AUTH_GENERIC_OAUTH_TOKEN_URL={{ observability_oidc.token_url }}
GF_AUTH_GENERIC_OAUTH_API_URL={{ observability_oidc.userinfo_url }}
GF_AUTH_SIGNOUT_REDIRECT_URL={{ observability_oidc.logout_url }}

# Which Grafana role each authentik group gets. Evaluated as JMESPath against
# the userinfo response, most privileged first.
#
# `role_attribute_strict` is what makes this a real access control rather than
# a default-plus-upgrade: without it, a user in neither group still gets in
# with Grafana's default role. With it, mapping to 'None' refuses the login —
# so membership in authentik is the only way in, which is the same rule the
# rest of the platform follows.
GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_PATH=contains(groups[*], '{{ observability_grafana_admin_group }}') && 'Admin' || contains(groups[*], '{{ observability_grafana_viewer_group }}') && 'Viewer' || 'None'
GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_STRICT=true

# Deliberately false. This maps to Grafana *server* administrator, which can
# read every organisation and edit the instance itself; `Admin` above is
# already full control of this organisation. Granting the server role from a
# group claim means an authentik change can silently widen it.
GF_AUTH_GENERIC_OAUTH_ALLOW_ASSIGN_GRAFANA_ADMIN=false

# No implicit account creation from an email domain — an account exists here
# because authentik authorised it, not because of what it is called.
GF_AUTH_GENERIC_OAUTH_AUTO_LOGIN=false
GF_AUTH_OAUTH_ALLOW_INSECURE_EMAIL_LOOKUP=false
{% else %}
# Single sign-on is not configured: OpenTofu has not created the OIDC client
# yet, or it is named something other than '{{ observability_grafana_oidc_slug }}'.
# Grafana is running with the local administrator above and nothing else.
GF_AUTH_GENERIC_OAUTH_ENABLED=false
{% endif %}
