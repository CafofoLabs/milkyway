services:
  proxy:
    build:
      context: .
      dockerfile: Dockerfile
    image: milkyway/fastmcp-proxy:{{ name }}
    restart: unless-stopped
    user: "10001:10001"
    read_only: true
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true]
    pids_limit: 128
    mem_limit: 512m
    cpus: 1.0
    tmpfs: [/tmp:rw,noexec,nosuid,size=32m,uid=10001,gid=10001]
    environment:
      FASTMCP_ENABLE_RICH_TRACEBACKS: "false"
      FASTMCP_LOG_LEVEL: ERROR
    volumes:
      - type: bind
        source: /etc/nimbus/secrets/{{ name }}-identity.json
        target: /run/secrets/identity.json
        read_only: true
        bind:
          create_host_path: false
      - type: bind
        source: /etc/komodo/stacks/{{ name }}/runtime.json
        target: /run/config/runtime.json
        read_only: true
        bind:
          create_host_path: false
    healthcheck:
      test: [CMD, python, /app/proxy.py, --healthcheck]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 30s
